---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Figure from '../../components/Figure.astro';
export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}
const { entry, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---
<Base title={d.title} description={d.summary}>
  <PageHead note="Field report" title={d.title} lede={d.summary} long>
    <dl class="casemeta">
      <dt>My part</dt><dd class="mine">{d.mine}</dd>
      <dt>Others</dt><dd>{d.others}</dd>
      <dt>Where</dt><dd>{d.where} <span class="anon">anonymised</span></dd>
    </dl>
  </PageHead>
  <section class="sec">
    <span class="note">Before and after</span>
    <div class="case-fig">
      <Figure type={d.figure} />
      <div class="shift"><span class="was">{d.shiftWas}</span><span class="to" aria-hidden="true">→</span><span class="is">{d.shiftNow}</span></div>
    </div>
  </section>
  <section class="sec">
    <span class="note">The report</span>
    <div class="prose"><Content /></div>
  </section>
  <section class="sec nextlink">
    <span class="note">Next report</span>
    <div><a href={`/work/${next.id}/`}>{next.data.title}</a></div>
  </section>
</Base>
