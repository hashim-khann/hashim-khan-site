---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
export async function getStaticPaths() {
  const all = await getCollection('log');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={d.title} description={d.summary}>
  <PageHead note={d.kind === 'note' ? 'Note' : 'Experiment'} title={d.title} lede={d.summary} long>
    <div class="entry-meta"><time datetime={d.date.toISOString()}>{date}</time>{d.status !== 'published' && <span class="st">{d.status}</span>}</div>
  </PageHead>
  <section class="sec">
    <span class="note"><a href="/log/">Back to the log</a></span>
    <div class="prose"><Content /></div>
  </section>
</Base>
