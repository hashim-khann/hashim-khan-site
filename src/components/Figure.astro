---
interface Props { type: 'redirects' | 'listings' | 'tree' }
const { type } = Astro.props;
const FIGS = {"redirects": "<div class=\"fig\">\n              <svg viewBox=\"0 0 320 130\" role=\"img\" aria-label=\"Diagram: old URLs mapped to new URLs\">\n                <text x=\"0\" y=\"12\">old</text><text x=\"262\" y=\"12\">new</text>\n                <g class=\"d-ink\" stroke-width=\"1.5\" fill=\"none\">\n                  <rect x=\"0\" y=\"22\" width=\"78\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                  <rect x=\"0\" y=\"48\" width=\"64\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                  <rect x=\"0\" y=\"74\" width=\"84\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                  <rect x=\"0\" y=\"100\" width=\"58\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                </g>\n                <g class=\"d-blue\" stroke-width=\"1.5\" fill=\"none\">\n                  <rect x=\"262\" y=\"30\" width=\"58\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                  <rect x=\"262\" y=\"62\" width=\"58\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                  <rect x=\"262\" y=\"94\" width=\"58\" height=\"14\" rx=\"2\" class=\"f-paper\"/>\n                </g>\n                <g class=\"d-red\" stroke-width=\"1.4\" fill=\"none\">\n                  <path class=\"flow\" d=\"M80 29 C170 29 170 37 260 37\"/>\n                  <path class=\"flow\" d=\"M66 55 C170 55 170 69 260 69\"/>\n                  <path class=\"flow\" d=\"M86 81 C170 81 170 69 260 69\"/>\n                  <path class=\"flow\" d=\"M60 107 C170 107 170 101 260 101\"/>\n                </g>\n                <text x=\"140\" y=\"125\">301</text>\n              </svg>\n              <p>Illustrative: every old URL needs a new home.</p>\n            </div>", "listings": "<div class=\"fig\">\n              <svg viewBox=\"0 0 220 130\" role=\"img\" aria-label=\"Diagram: store listings spread across many locations\">\n                <g class=\"f-ink\">\n                  <circle cx=\"22\" cy=\"30\" r=\"4\"/><circle cx=\"48\" cy=\"58\" r=\"4\"/><circle cx=\"30\" cy=\"94\" r=\"4\"/>\n                  <circle cx=\"74\" cy=\"26\" r=\"4\"/><circle cx=\"90\" cy=\"76\" r=\"4\"/><circle cx=\"66\" cy=\"110\" r=\"4\"/>\n                  <circle cx=\"118\" cy=\"44\" r=\"4\"/><circle cx=\"132\" cy=\"98\" r=\"4\"/><circle cx=\"150\" cy=\"20\" r=\"4\"/>\n                  <circle cx=\"166\" cy=\"66\" r=\"4\"/><circle cx=\"188\" cy=\"104\" r=\"4\"/><circle cx=\"200\" cy=\"38\" r=\"4\"/>\n                  <circle cx=\"110\" cy=\"118\" r=\"4\"/><circle cx=\"176\" cy=\"122\" r=\"4\"/>\n                </g>\n                <g class=\"f-red\"><circle cx=\"90\" cy=\"76\" r=\"5\"/><circle cx=\"166\" cy=\"66\" r=\"5\"/></g>\n                <g class=\"f-blue\"><circle cx=\"48\" cy=\"58\" r=\"5\"/><circle cx=\"150\" cy=\"20\" r=\"5\"/><circle cx=\"188\" cy=\"104\" r=\"5\"/></g>\n              </svg>\n              <p>Illustrative: brand outlets (blue), express stores (red) and retailers (grey), each with its own listing.</p>\n            </div>", "tree": "<div class=\"fig\">\n              <svg viewBox=\"0 0 360 140\" role=\"img\" aria-label=\"Diagram: site structure branching into many course landing pages\">\n                <g class=\"d-ink\" stroke-width=\"1.2\" fill=\"none\">\n                  <path d=\"M180 22 L60 62 M180 22 L140 62 M180 22 L220 62 M180 22 L300 62\"/>\n                  <path d=\"M60 70 L30 110 M60 70 L50 110 M60 70 L70 110 M60 70 L90 110\n                           M140 70 L110 110 M140 70 L130 110 M140 70 L150 110 M140 70 L170 110\n                           M220 70 L190 110 M220 70 L210 110 M220 70 L230 110 M220 70 L250 110\n                           M300 70 L270 110 M300 70 L290 110 M300 70 L310 110 M300 70 L330 110\"/>\n                </g>\n                <rect x=\"160\" y=\"8\" width=\"40\" height=\"16\" rx=\"3\" class=\"f-blue\"/>\n                <g class=\"f-paper d-ink\" stroke-width=\"1.4\">\n                  <rect x=\"46\" y=\"60\" width=\"28\" height=\"12\" rx=\"2\"/><rect x=\"126\" y=\"60\" width=\"28\" height=\"12\" rx=\"2\"/>\n                  <rect x=\"206\" y=\"60\" width=\"28\" height=\"12\" rx=\"2\"/><rect x=\"286\" y=\"60\" width=\"28\" height=\"12\" rx=\"2\"/>\n                </g>\n                <g class=\"f-red\">\n                  <rect x=\"27\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"47\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"67\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"87\" y=\"110\" width=\"6\" height=\"6\"/>\n                  <rect x=\"107\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"127\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"147\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"167\" y=\"110\" width=\"6\" height=\"6\"/>\n                  <rect x=\"187\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"207\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"227\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"247\" y=\"110\" width=\"6\" height=\"6\"/>\n                  <rect x=\"267\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"287\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"307\" y=\"110\" width=\"6\" height=\"6\"/><rect x=\"327\" y=\"110\" width=\"6\" height=\"6\"/>\n                </g>\n                <text x=\"128\" y=\"136\">200+ course landing pages</text>\n              </svg>\n              <p>Structure, not scale: the real tree is much wider.</p>\n            </div>"};
---
<Fragment set:html={FIGS[type]} />
