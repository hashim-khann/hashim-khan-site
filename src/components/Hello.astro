---
import { SITE } from '../data/site';
---
<section class="sec contact" aria-labelledby="contact-h">
  <span class="note">Say hello</span>
  <div>
    <h2 id="contact-h">Working on something?</h2>
    <p>If you want to talk search, AI, websites or organic growth, write to me.</p>
    <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <div class="links"><a href={SITE.linkedin}>LinkedIn</a><a href="/contact/">More ways to reach me</a></div>
  </div>
</section>
